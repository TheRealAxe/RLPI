# Copier ce fichier en .env puis le remplir.

# Clé API ballchasing (ballchasing.com > connexion > onglet Upload > créer une clé API).
BALLCHASING_TOKEN=

# Nom de la source des parties suivies : data/frames/<source>/ et data/features/*_<source>.*
# « theo » par défaut (données de Théo) ; « perso » dans le kit partagé.
RLPI_SOURCE=

# Profil suivi : identifiant (ex. Steam:7656119..., Epic:abcd...) ou pseudo exact en jeu.
# Vide avec la source « theo » : profil de Théo. Vide sinon : détecté par l'application.
RLPI_PLAYER=

# Coéquipiers à comparer dans le tableau de bord (pseudos ou identifiants, séparés par des virgules).
RLPI_COMPARE=

# Dossier des replays et date de début facultative (AAAA-MM-JJ) : réglés depuis l'application.
RLPI_DEMOS=
RLPI_SINCE=

# Facultatif : autre dossier de données / de modèles (utilisé par le traitement partie par partie).
# RLPI_DATA=
# RLPI_MODELS=
