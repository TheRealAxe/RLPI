# Image du worker RLPI pour Coolify : traite les parties de la file Redis (src/rlpi/worker.py).
# Les 6 modèles nécessaires sont copiés dans l'image depuis models/ (voir models/README.md) : aucun volume à
# préparer sur le serveur.
FROM python:3.13-slim

# libgomp1 : nécessaire à LightGBM.
# postgresql-client-18 : pg_dump / pg_restore de la sauvegarde quotidienne (rlpi.backup), même version majeure que le
# serveur Postgres (18). Dépôt officiel apt.postgresql.org (Debian n'a que la version 17).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 ca-certificates curl \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && . /etc/os-release \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt ${VERSION_CODENAME}-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    RLPI_MODELS=/app/models \
    RLPI_DATA=/tmp/rlpi-data \
    RLPI_LOG_FORMAT=json

# Dépendances : extra « worker » (LightGBM, scikit-learn, subtr-actor-py, ballchasing), versions exactes de uv.lock.
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /bin/uv
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_COMPILE_BYTECODE=0 UV_LINK_MODE=copy PATH=/app/.venv/bin:$PATH
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra worker && rm -rf /root/.cache

COPY config ./config
COPY src ./src
COPY models ./models

RUN useradd --create-home app
USER app

# En vie si la boucle a tourné depuis moins de 20 min (une partie dure au plus RLPI_GAME_TIMEOUT = 15 min)
HEALTHCHECK --interval=60s --timeout=5s --start-period=60s \
  CMD python -c "import os,sys,tempfile,time; p=os.path.join(tempfile.gettempdir(),'rlpi_worker_heartbeat'); sys.exit(0 if os.path.exists(p) and time.time()-os.path.getmtime(p) < 1200 else 1)"

CMD ["python", "-m", "rlpi.worker", "run"]
