{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "rlpi": {"()": "rlpi.logs.JsonFormatter"}
  },
  "handlers": {
    "stdout": {"class": "logging.StreamHandler", "formatter": "rlpi", "stream": "ext://sys.stdout"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"handlers": ["stdout"], "level": "INFO", "propagate": false},
    "uvicorn.access": {"handlers": [], "level": "WARNING", "propagate": false}
  },
  "root": {"handlers": ["stdout"], "level": "WARNING"}
}
