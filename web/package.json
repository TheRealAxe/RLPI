{
  "name": "rlpi-web",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Interface du RLPI (Vue 3) : tableau de bord, Les modèles, swipe. Lit l'API FastAPI (src/rlpi/web).",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "api-types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "three": "^0.160.0",
    "vue": "3.5.45",
    "vue-router": "5.5.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-tsc": "3.3.14"
  },
  "engines": {
    "node": ">=22.12"
  }
}
